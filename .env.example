# ==============================================================================
# DECORITU — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development or set these variables in your
# deployment platform (e.g., Vercel, Railway, Render, Fly.io, AWS, Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# For Local Development:
# Uses SQLite embedded database file.
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL recommended):
# Step 1: In prisma/schema.prisma, change provider to "postgresql"
# Step 2: Set your PostgreSQL connection string below:
# DATABASE_URL="postgresql://username:password@db-host.com:5432/decoritu?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# Used for encrypting session cookies and hashing sensitive tokens.
# Generate a secure 32+ character random secret using:
#   openssl rand -base64 32
AUTH_SECRET="decoritu-production-secret-change-this-to-a-random-32-char-string"

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR ACCOUNT (Required for `npm run db:seed`)
# ------------------------------------------------------------------------------
# These credentials will be created upon running `npm run db:seed`.
# Used to access the Admin Studio at /admin.
ADMIN_EMAIL="admin@decoritu.in"
ADMIN_PASSWORD="DecorituAdmin!2026"

# ------------------------------------------------------------------------------
# 4. SITE METADATA & DOMAIN (Required)
# ------------------------------------------------------------------------------
# Canonical website origin used for generating dynamic metadata, OpenGraph,
# Twitter cards, canonical tags, and sitemap.xml.
# Local: http://localhost:3000
# Production: https://www.yourdomain.com (without trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "false" for live commercial launch with real orders.
# Set to "true" to display preview and demo notices on storefront and checkout.
NEXT_PUBLIC_DEMO_MODE="true"

# ------------------------------------------------------------------------------
# 5. ONLINE PAYMENT GATEWAY — RAZORPAY (Optional)
# ------------------------------------------------------------------------------
# If left blank, the store will operate in Cash on Delivery (COD) mode.
# Sign up at https://razorpay.com to obtain test or live API keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAILS — RESEND (Optional)
# ------------------------------------------------------------------------------
# If left blank, orders and password reset links will be generated and tracked
# within the database and user accounts without sending outgoing SMTP emails.
# Sign up at https://resend.com to obtain an API key.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="Decoritu <orders@decoritu.in>"
